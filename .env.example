# ==============================================================================
# NutriNexa Environment Variables (Supabase PostgreSQL + Drizzle ORM)
# ==============================================================================

# Supabase PostgreSQL Connection String (Direct or Session Pooler: port 5432 / Transaction Pooler: port 6543)
# Find this in your Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres"

# Supabase Project Credentials (Found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# JWT Secret for Session Hashing & Auth Signing
JWT_SECRET="nutrinexa-scientific-research-secure-key-2026-v2"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
