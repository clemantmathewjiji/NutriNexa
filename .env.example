# NutriNexa Environment Variables Configuration Example
# Copy this file to .env.local and update with your actual credentials.

# Database URL (Postgres via Supabase IPv4 transaction-mode pooler)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_publishable_anon_key"
SUPABASE_SERVICE_ROLE_KEY=""

# Security Signing Secret for Session Authentication
JWT_SECRET="your-secure-session-signing-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Vercel AI Gateway (for Vercel AI SDK models)
AI_GATEWAY_API_KEY=""
