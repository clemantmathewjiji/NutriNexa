# -----------------------------------------------------------------------------
# NutriNexa — Environment Configuration Template
# Populate these variables in your deployment environment or in .env.local
# -----------------------------------------------------------------------------

# 1. Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Direct port 5432)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
DATABASE_URL=

# 2. Supabase API Configuration (for Supabase Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Google OAuth Provider (configured in Google Cloud Console & Supabase Dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
